<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    nsURI="http://example.com/property"
    nsPrefix="property"
    name="PropertyMetamodel">
  <eClassifiers xsi:type="ecore:EClass" name="Property">
    <eStructuralFeatures xsi:type="ecore:EReference" name="House"
        eType="houseMetamodel.ecore#//House" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Tree"
        eType="#//Greens/Tree" upperBound="-1" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="ObjectTest"
        eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
  </eClassifiers>

  <eSubpackages
      nsURI="http://example.com/property/greens"
      nsPrefix="greens"
      name="Greens">
    <eClassifiers xsi:type="ecore:EClass" name="Tree"/>
  </eSubpackages>
</ecore:EPackage>
